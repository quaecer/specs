{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quaecer.github.io/specs/qualification/1.0/use-registry.schema.json",
  "title": "Qualification use registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "uses", "edges", "closure", "instance_relation"],
  "properties": {
    "format": {"const": "qualification-use-registry@1"},
    "uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/use"}
    },
    "edges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "source"],
        "properties": {
          "target": {"$ref": "#/$defs/use"},
          "source": {"$ref": "#/$defs/use"}
        }
      }
    },
    "closure": {"const": "reflexive_transitive"},
    "instance_relation": {"const": "canonical_semantic_equality"}
  },
  "$defs": {
    "use": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?![\\s\\S])"
    }
  }
}
