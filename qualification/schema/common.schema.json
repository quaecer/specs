{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quaecer.github.io/specs/qualification/1.0/common.schema.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "iri": {
      "type": "string",
      "format": "iri",
      "maxLength": 2048,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\\\\|{}#]+(?:#[^\\s<>\\\\|{}#]*)?(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|(?!-00:00)[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decimal": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+-]?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?(?:[0-9]{1,3}|1000))?(?![\\s\\S])"
    },
    "use_kind": {
      "$ref": "use-registry.schema.json#/$defs/use"
    },
    "channel": {
      "enum": [
        "context",
        "tool_results",
        "network",
        "persistent_memory",
        "caches"
      ]
    },
    "dimension": {
      "enum": [
        "empirical_roots",
        "population",
        "instrument",
        "method",
        "model_family",
        "provider",
        "information_exposure"
      ]
    },
    "pin": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/iri"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "end": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    }
  }
}
